# URL base del backend FastAPI (sin /api al final).
# Dejarlo en http:// aunque uses `npm run dev:https`: el 8000 solo habla HTTP
# plano y nunca va a responder TLS (da "WARNING: Invalid HTTP request received"
# en el backend y "No se pudo conectar con el servidor" en la UI). Cuando el
# portal se sirve por HTTPS, lib/auth.ts detecta el protocolo de la página y
# usa https://localhost:8443, el proxy que levanta dev:https por delante del 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional (producción con portal y API en dominios distintos): "true" hace que
# el portal reenvíe /api/* al backend (rewrite de next.config.ts) y el navegador
# solo hable con su propio origen, para que la cookie de refresh sea de primera
# parte. Con "true", en el backend: COOKIE_SAMESITE=lax y FRONTEND_ORIGINS con el
# origen del portal. Vacío = el navegador llama directo al backend (cross-site).
NEXT_PUBLIC_API_PROXY=

# App ID de Meta (Facebook Login for Business)
NEXT_PUBLIC_META_APP_ID=

# Opcional: config_id de Facebook Login for Business. Si se define, FB.login()
# lo usa en vez de pedir scopes sueltos.
NEXT_PUBLIC_META_CONFIG_ID=

# Opcional: redirect_uri que se manda a POST /api/canales/meta/conectar.
# Si queda vacío, el backend usa META_REDIRECT_URI.
NEXT_PUBLIC_META_REDIRECT_URI=

# config_id de WhatsApp Embedded Signup (Inicio de sesión con Facebook para
# empresas → Configuraciones → "whatsapp-embedded-signup"), distinto del
# NEXT_PUBLIC_META_CONFIG_ID de Facebook/Instagram de arriba. Vacío = el botón
# "Conectar WhatsApp con Meta" queda deshabilitado (NeuroAPI sigue siendo el
# proveedor real mientras Meta no apruebe Acceso Avanzado de whatsapp_business_*).
NEXT_PUBLIC_META_WA_CONFIG_ID=

# Client ID de Google (mismo GOOGLE_CLIENT_ID del backend) para el botón
# "Continuar con Google" de /login y /registro. Vacío = el botón no se
# dibuja y solo queda el alta con correo.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
